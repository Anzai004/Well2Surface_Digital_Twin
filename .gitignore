# Python cache, bytecode, and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Data isolation (preserves folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep

# Generated Simulation Artifacts & Reports
reports/*
!reports/.gitkeep

# LaTeX build intermediates (in case pdflatex runs in root)
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Project reference materials & local notes
prerequisites/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp